@using Microsoft.EntityFrameworkCore
@using BrewHouse.Data
@using BrewHouse.Services
@using Wolverine
@implements IDisposable
@inject IDbContextFactory<AuctionDbContext> DbContextFactory
@inject IMessageBus MessageBus
@inject IBidsClient BidsClient

<h2>☕ Live Bids</h2>

@if (_coffeeLots is null)
{
    <p class="loading-state">Loading coffee lots...</p>
}
else if (_coffeeLots.Count == 0)
{
    <p class="empty-state">No coffee lots listed.</p>
}
else
{
    <table class="bids-table">
        <thead>
            <tr>
                <th>Origin</th>
                <th class="bid-col">Current Bid</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _coffeeLots)
            {
                <tr class="@(_recentlyUpdated.Contains(item.Id) ? "just-bid" : "")">
                    <td class="lot-origin">@item.Origin</td>
                    <td class="lot-bid bid-col" data-testid="bid-@item.Id">@item.CurrentBid.ToString("C")</td>
                    <td class="bid-col">
                        <button @onclick="() => PlaceBidAsync(item.Id, item.CurrentBid + 500m)">
                            Bid @((item.CurrentBid + 500m).ToString("C"))
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CoffeeLot>? _coffeeLots;
    private readonly HashSet<int> _recentlyUpdated = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        _coffeeLots = await db.CoffeeLots.OrderBy(l => l.Origin).ToListAsync();

        BidsClient.BidPlaced += OnBidPlaced;
        await BidsClient.StartAsync();
    }

    private void OnBidPlaced(int coffeeLotId, decimal currentBid)
    {
        var item = _coffeeLots?.FirstOrDefault(e => e.Id == coffeeLotId);
        if (item is null)
            return;

        item.CurrentBid = currentBid;
        _recentlyUpdated.Add(coffeeLotId);
        InvokeAsync(StateHasChanged);
        _ = ClearHighlightAfterDelayAsync(coffeeLotId);
    }

    private async Task ClearHighlightAfterDelayAsync(int coffeeLotId)
    {
        await Task.Delay(TimeSpan.FromSeconds(2));
        _recentlyUpdated.Remove(coffeeLotId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlaceBidAsync(int coffeeLotId, decimal amount)
        => await MessageBus.PublishAsync(new ProcessBidMessage { CoffeeLotId = coffeeLotId, BidAmount = amount });

    // Unsubscribe only. IBidsClient is a scoped DI service, so the container owns its
    // lifetime and disposes it when the circuit ends - disposing it here as well would
    // tear down a service this component did not create.
    public void Dispose() => BidsClient.BidPlaced -= OnBidPlaced;
}
