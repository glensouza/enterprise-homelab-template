@using Microsoft.EntityFrameworkCore
@using BrewHouse.Data
@using BrewHouse.Services
@using Wolverine
@implements IDisposable
@inject IDbContextFactory<AuctionDbContext> DbContextFactory
@inject IMessageBus MessageBus
@inject IBidsClient BidsClient

<h2>Live Bids</h2>

@if (_coffeeLots is null)
{
    <p>Loading coffee lots...</p>
}
else if (_coffeeLots.Count == 0)
{
    <p>No coffee lots listed.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Origin</th>
                <th>Current Bid</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _coffeeLots)
            {
                <tr>
                    <td>@item.Origin</td>
                    <td data-testid="bid-@item.Id">@item.CurrentBid.ToString("C")</td>
                    <td><button @onclick="() => PlaceBidAsync(item.Id, item.CurrentBid + 500m)">Place Bid</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CoffeeLot>? _coffeeLots;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        _coffeeLots = await db.CoffeeLots.ToListAsync();

        BidsClient.BidPlaced += OnBidPlaced;
        await BidsClient.StartAsync();
    }

    private void OnBidPlaced(int coffeeLotId, decimal currentBid)
    {
        var item = _coffeeLots?.FirstOrDefault(e => e.Id == coffeeLotId);
        if (item is null)
            return;

        item.CurrentBid = currentBid;
        InvokeAsync(StateHasChanged);
    }

    private async Task PlaceBidAsync(int coffeeLotId, decimal amount)
        => await MessageBus.PublishAsync(new ProcessBidMessage { CoffeeLotId = coffeeLotId, BidAmount = amount });

    // Unsubscribe only. IBidsClient is a scoped DI service, so the container owns its
    // lifetime and disposes it when the circuit ends - disposing it here as well would
    // tear down a service this component did not create.
    public void Dispose() => BidsClient.BidPlaced -= OnBidPlaced;
}
