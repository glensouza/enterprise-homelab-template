[Unit]
Description=CritterWatch (JasperFx Wolverine/Marten monitoring console)
After=network.target

[Service]
WorkingDirectory=/var/www/critterwatch/current
ExecStart=/usr/bin/dotnet /var/www/critterwatch/current/CritterWatchHost.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5000
# Secrets (ConnectionStrings__critterwatch, ConnectionStrings__messaging) are
# rendered into this file by the Infisical Agent (roles/infisical-agent,
# infisical_agent_env_path override - docs/01 ADR 91). The app fails fast
# without them, same pattern as BrewHouse's own blazor-app.service.
EnvironmentFile=-/etc/critterwatch/critterwatch.env
User=www-data
Group=www-data
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/critterwatch
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
