[Unit]
Description=authentik RADIUS Outpost
After=network.target authentik-server.service
Wants=authentik-server.service

[Service]
User=authentik
Group=authentik
EnvironmentFile=/etc/default/authentik-radius
ExecStart=/opt/authentik/bin/authentik-radius
WorkingDirectory=/opt/authentik/
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
