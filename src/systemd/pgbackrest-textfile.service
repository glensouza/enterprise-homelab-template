[Unit]
Description=Publish pgBackRest last-backup time to the node_exporter textfile collector
# Without the NAS mount pgbackrest cannot read the repo; skip rather than publish a bogus failure.
ConditionPathIsMountPoint=/mnt/synology/postgres-data

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/pgbackrest-textfile.sh
