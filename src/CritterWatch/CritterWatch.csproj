<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Confirmed live: NuGet raises NU1108 ("Cycle detected: CritterWatch ->
         CritterWatch") when this project's own inferred package identity
         (assembly name, defaulted from the .csproj filename) matches the
         referenced CritterWatch package's name exactly. Distinct
         AssemblyName avoids the collision; src/systemd/critterwatch.service
         and deploy-critterwatch.yml both reference CritterWatchHost.dll. -->
    <AssemblyName>CritterWatchHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CritterWatch" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
  </ItemGroup>
</Project>
