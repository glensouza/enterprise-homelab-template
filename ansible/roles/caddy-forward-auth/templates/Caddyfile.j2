# Managed by Ansible (roles/caddy-forward-auth) — manual edits will be overwritten.
#
# Single-site Caddy front for {{ caddy_fa_fqdn }} (docs/01 ADR 66): TLS via
# step-ca ACME (same pattern as roles/authentik and roles/preview-host —
# Caddy's automatic HTTPS refuses to ACME-issue for *.internal names, so the
# explicit `tls { ca ... }` below is required), gated by an Authentik
# forward-auth check against the embedded outpost before the app itself is
# reached.
#
# route{} + the /outpost.goauthentik.io/* passthrough match Authentik's own
# official Caddy template exactly (docs/01 ADR 68) - without route{}, Caddy's
# default (unordered) directive application let requests reach the backend
# regardless of the forward_auth result; without the passthrough, the OAuth
# callback that completes login has nowhere to land.
#
# `header_up Host` MUST be the bare hostname, no port (docs/01 ADR 71) -
# without an override, Caddy's dial-address-based default is
# "authentik.{{ internal_domain }}:443" (port included), and Authentik's
# outpost selects which of its providers should handle a forward_domain
# request by checking literal_host.ends_with(cookie_domain) - a ":443"
# suffix makes that check fail for every provider, silently routing the
# request to Authentik's own core backend instead of the outpost's
# forward-auth logic at all. That's the actual cause of ADR 68's "anonymous
# bypass" - not a real Authentik bug, a Caddy default this repo didn't
# override correctly. Confirmed live: with the port included, the check
# always returns a bare 200 with no session cookie (silently falls through
# to core, which just 404s/200s incidentally depending on path); with the
# bare hostname, it returns a real 302 to the login flow with a Set-Cookie.
{{ caddy_fa_fqdn }} {
	tls {
		ca {{ step_ca_url }}/acme/acme/directory
		ca_root /etc/caddy/pki/root_ca.crt
	}

	route {
		reverse_proxy /outpost.goauthentik.io/* https://authentik.{{ internal_domain }} {
			header_up Host authentik.{{ internal_domain }}
			transport http {
				tls_trust_pool file /etc/caddy/pki/root_ca.crt
			}
		}

		forward_auth https://authentik.{{ internal_domain }} {
			uri /outpost.goauthentik.io/auth/caddy
			header_up Host authentik.{{ internal_domain }}
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			trusted_proxies private_ranges
			transport http {
				tls_trust_pool file /etc/caddy/pki/root_ca.crt
			}
		}

		reverse_proxy {{ caddy_fa_backend }}
	}

	# Sibling of route{}, not nested inside it - confirmed live (docs/01 ADR
	# 68) that Caddy rejects handle_errors inside a route{} block ("only
	# handler directives can be used in routes"). Applies to errors from
	# anything in the site block, including route{}'s contents.
	handle_errors {
		@redirect expression `{http.error.status_code} in [401, 403]`
		redir @redirect https://authentik.{{ internal_domain }}/outpost.goauthentik.io/start?rd={scheme}://{host}{uri} 302
	}
}
