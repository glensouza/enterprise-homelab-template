# Managed by Ansible (roles/homepage) — manual edits will be overwritten.
# HOMEPAGE_ALLOWED_HOSTS is required as of Homepage's Next.js host-header
# allow-list - without the LXC's own IP listed here, requests that aren't
# to "localhost:3000" are rejected outright (upstream installer sets this
# exact pattern). homepage.smartsoftwarecoffee.com (no port - Cloudflare
# forwards the original public Host header as-is) is the Cloudflare Tunnel
# Public Hostname route added in ADR 47, terminating TLS at Cloudflare's
# edge and forwarding plain HTTP to this LXC on :3000, same pattern as the
# BrewHouse app's own tunnel route.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,{{ ansible_host }}:3000,homepage.{{ internal_domain }}:3000,homepage.smartsoftwarecoffee.com

# ADR 41: password auth, required before any public exposure. Confirmed
# live against the installed source: the login form is password-only, no
# username field exists at all - just enter homepage_auth_password, pushed
# to Infisical as HOMEPAGE_AUTH_PASSWORD (roles/homepage/tasks/main.yml).
HOMEPAGE_AUTH_ENABLED=true
HOMEPAGE_AUTH_SECRET={{ homepage_auth_secret }}
HOMEPAGE_AUTH_PASSWORD={{ homepage_auth_password }}
HOMEPAGE_EXTERNAL_URL=http://homepage.{{ internal_domain }}:3000
