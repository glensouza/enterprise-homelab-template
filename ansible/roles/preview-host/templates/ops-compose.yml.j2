# Always-on admin tooling stack (ADR 21) — independent of the per-PR preview
# stacks. Rendered by Ansible (preview-host role) to /opt/ops/docker-compose.yml.
# UIs are exposed through Caddy on 443 (see ops.caddy.j2); all published ports
# are loopback-only. Watchtower only touches labeled containers in THIS stack —
# running PR preview stacks are never mutated.
name: ops

services:
  portainer:
    image: portainer/portainer-ce:latest
    restart: unless-stopped
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    ports:
      - "127.0.0.1:9000:9000"

  dozzle:
    image: amir20/dozzle:latest
    restart: unless-stopped
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - dozzle_data:/data
    ports:
      - "127.0.0.1:8080:8080"

  watchtower:
    # docs/01 ADR 103: containrrr/watchtower was archived upstream
    # (Dec 2025, no new builds since 2023-11) - confirmed live, its
    # vendored Docker client (API 1.25) couldn't even start against this
    # host's current Docker Engine (API 1.56, bumped by the fleet patch's
    # OS upgrade), crash-looping on every start. nickfedor/watchtower is
    # the actively-maintained drop-in fork (same image name, same env
    # vars, same socket mount) - https://github.com/nicholas-fedor/watchtower
    image: nickfedor/watchtower:latest
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      WATCHTOWER_LABEL_ENABLE: "true"
      WATCHTOWER_CLEANUP: "true"
      WATCHTOWER_SCHEDULE: "0 0 4 * * *"

  pgadmin:
    image: dpage/pgadmin4:latest
    restart: unless-stopped
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_DEFAULT_EMAIL}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_DEFAULT_PASSWORD}
{% if pgadmin_oidc_client_id is defined %}
      # step-ca is a private root CA - Python's requests library (which
      # pgAdmin's OAuth2 client uses) doesn't trust it by default, confirmed
      # live: SSLCertVerificationError fetching Authentik's OIDC discovery
      # document without this (docs/01 ADR 73).
      REQUESTS_CA_BUNDLE: /etc/ssl/certs/step-ca-root.crt
{% endif %}
    ports:
      - "127.0.0.1:8081:80"
    volumes:
      - pgadmin_data:/var/lib/pgadmin
{% if pgadmin_oidc_client_id is defined %}
      - ./pgadmin_config_local.py:/pgadmin4/config_local.py:ro
      - /etc/caddy/pki/root_ca.crt:/etc/ssl/certs/step-ca-root.crt:ro
{% endif %}

  redisinsight:
    image: redis/redisinsight:latest
    restart: unless-stopped
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    ports:
      - "127.0.0.1:5540:5540"
    volumes:
      - redisinsight_data:/data

volumes:
  portainer_data:
  pgadmin_data:
  redisinsight_data:
  dozzle_data:
