# Standing Floci console site (docs/11, ADR 19/21) - rendered by Ansible.
# Fronts floci-ui (AWS/Azure/GCP console; OCI has no UI as of floci-ui v0.3.0,
# see ../floci/README.md). Certificates issued by step-ca over ACME exactly
# like the ops-stack and per-PR sites — explicit `tls` block required, same
# .internal-domain caveat as ops.caddy.j2.
floci.{{ internal_domain }} {
	tls {
		ca {{ step_ca_url }}/acme/acme/directory
		ca_root /etc/caddy/pki/root_ca.crt
	}
	reverse_proxy 127.0.0.1:4500
}
