# Static admin-tooling sites (ADR 21) — rendered by Ansible. Certificates are
# issued by step-ca over ACME exactly like the per-PR sites. PR sites live in
# /etc/caddy/pr-sites/ and are managed by CI, not Ansible.
#
# Explicit `tls` block required on every site here, confirmed live: Caddy's
# automatic HTTPS treats any *.internal name as "obviously not publicly
# issuable" and silently falls back to its own self-signed "Caddy Local
# Authority" for it, ignoring the global `acme_ca`/`acme_ca_root` in
# Caddyfile.j2 — those only apply to hostnames that pass Caddy's public-CA
# eligibility check, which .internal always fails. The per-site `tls { ca
# ... }` below is what actually forces step-ca to be used.
#
# Dozzle and RedisInsight additionally sit behind Authentik forward-auth
# (docs/01 ADR 66) — tier-2 SSO per the S3-01 rollout. Portainer/pgAdmin stay
# open here; they're slated for tier-1 native OIDC, not forward-auth.
#
# route{} + the /outpost.goauthentik.io/* passthrough + header_up Host below
# match roles/caddy-forward-auth's own template and Authentik's official
# Caddy docs exactly - see that role's Caddyfile.j2 for the full rationale.
# header_up Host MUST be the bare hostname, no port (docs/01 ADR 71) - with
# the port included, Authentik's outpost never matches this request to any
# provider and silently routes it to its own core backend instead of the
# forward-auth check, which is what made this look like a bypass.
portainer.{{ internal_domain }} {
	tls {
		ca {{ step_ca_url }}/acme/acme/directory
		ca_root /etc/caddy/pki/root_ca.crt
	}
	reverse_proxy 127.0.0.1:9000
}

dozzle.{{ internal_domain }} {
	tls {
		ca {{ step_ca_url }}/acme/acme/directory
		ca_root /etc/caddy/pki/root_ca.crt
	}

	route {
		reverse_proxy /outpost.goauthentik.io/* https://authentik.{{ internal_domain }} {
			header_up Host authentik.{{ internal_domain }}
			transport http {
				tls_trust_pool file /etc/caddy/pki/root_ca.crt
			}
		}

		forward_auth https://authentik.{{ internal_domain }} {
			uri /outpost.goauthentik.io/auth/caddy
			header_up Host authentik.{{ internal_domain }}
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			trusted_proxies private_ranges
			transport http {
				tls_trust_pool file /etc/caddy/pki/root_ca.crt
			}
		}

		reverse_proxy 127.0.0.1:8080
	}

	# Sibling of route{}, not nested inside it - confirmed live (docs/01 ADR
	# 68) that Caddy rejects handle_errors inside a route{} block.
	handle_errors {
		@redirect expression `{http.error.status_code} in [401, 403]`
		redir @redirect https://authentik.{{ internal_domain }}/outpost.goauthentik.io/start?rd={scheme}://{host}{uri} 302
	}
}

pgadmin.{{ internal_domain }} {
	tls {
		ca {{ step_ca_url }}/acme/acme/directory
		ca_root /etc/caddy/pki/root_ca.crt
	}
	reverse_proxy 127.0.0.1:8081
}

redisinsight.{{ internal_domain }} {
	tls {
		ca {{ step_ca_url }}/acme/acme/directory
		ca_root /etc/caddy/pki/root_ca.crt
	}

	route {
		reverse_proxy /outpost.goauthentik.io/* https://authentik.{{ internal_domain }} {
			header_up Host authentik.{{ internal_domain }}
			transport http {
				tls_trust_pool file /etc/caddy/pki/root_ca.crt
			}
		}

		forward_auth https://authentik.{{ internal_domain }} {
			uri /outpost.goauthentik.io/auth/caddy
			header_up Host authentik.{{ internal_domain }}
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			trusted_proxies private_ranges
			transport http {
				tls_trust_pool file /etc/caddy/pki/root_ca.crt
			}
		}

		reverse_proxy 127.0.0.1:5540
	}

	# Sibling of route{}, not nested inside it - confirmed live (docs/01 ADR
	# 68) that Caddy rejects handle_errors inside a route{} block.
	handle_errors {
		@redirect expression `{http.error.status_code} in [401, 403]`
		redir @redirect https://authentik.{{ internal_domain }}/outpost.goauthentik.io/start?rd={scheme}://{host}{uri} 302
	}
}
