infisical:
  address: "http://{{ hostvars['infisical'].ansible_host }}:8080"
auth:
  type: "universal-auth"
  config:
    client-id: "/etc/infisical/client-id"
    client-secret: "/etc/infisical/client-secret"
templates:
  - template-content: |
{% raw %}
      {{- with listSecrets "{% endraw %}{{ infisical_agent_project_id }}{% raw %}" "{% endraw %}{{ infisical_environment }}{% raw %}" "{% endraw %}{{ infisical_agent_secret_path }}{% raw %}" }}
      {{- range . }}
      {{ .Key }}={{ .Value }}
      {{- end }}
      {{- end }}
{% endraw %}
    destination-path: "{{ infisical_agent_env_path }}"
    config:
      polling-interval: 5m
