# Rendered by roles/authentik (docs/01 ADR 120) and piped to `django-admin shell`.
# Idempotent get-or-update of ONE tier-1 OAuth2/OIDC Provider + Application (plus the custom scope
# mappings and groups some apps need). client_id/client_secret are NOT generated by Authentik: they
# are the deterministic values in oidc_clients (group_vars/all, cached under /opt/ansible-credentials
# on the controller), so the app side and this side always agree, including after Authentik is wiped
# and rebuilt. Plain top-level statements on purpose - `django-admin shell` execs stdin with
# separate globals/locals, so comprehensions/functions referencing top-level names would NameError.
from authentik.core.models import Application, Group, User
from authentik.crypto.models import CertificateKeyPair
from authentik.flows.models import Flow
from authentik.providers.oauth2.models import (
    ClientType,
    GrantType,
    OAuth2Provider,
    RedirectURI,
    RedirectURIMatchingMode,
    ScopeMapping,
)

app_name = "{{ item.name }}"
provider_name = "{{ item.name }}"
slug = "{{ item.slug }}"
client_type = "{{ item.client_type | default('confidential') }}"
client_id = "{{ item.client_id }}"
client_secret = "{{ item.client_secret | default('') }}"
redirect_urls = {{ item.redirect_uris | to_json }}
changed = False

auth_flow = Flow.objects.get(slug="default-provider-authorization-implicit-consent")
invalidation_flow = Flow.objects.get(slug="default-provider-invalidation-flow")
# RS256 (asymmetric): with no signing key Authentik signs with HS256 and serves an EMPTY JWKS, which
# breaks every client that verifies the ID token against jwks_uri (ADR 75/76: RabbitMQ, pgAdmin).
signing_key = CertificateKeyPair.objects.filter(name="authentik Self-signed Certificate").first()

mappings = list(
    ScopeMapping.objects.filter(
        managed__in=[
            "goauthentik.io/providers/oauth2/scope-openid",
            "goauthentik.io/providers/oauth2/scope-email",
            "goauthentik.io/providers/oauth2/scope-profile",
        ]
    )
)
{% for sm in item.scope_mappings | default([]) %}

sm = ScopeMapping.objects.filter(name={{ sm.name | to_json }}).first()
if sm is None:
    sm = ScopeMapping(name={{ sm.name | to_json }})
    changed = True
if sm.scope_name != {{ sm.scope_name | to_json }} or sm.expression != {{ sm.expression | to_json }}:
    sm.scope_name = {{ sm.scope_name | to_json }}
    sm.expression = {{ sm.expression | to_json }}
    changed = True
if changed:
    sm.save()
mappings.append(sm)
{% endfor %}

provider = OAuth2Provider.objects.filter(name=provider_name).first()
if provider is None:
    provider = OAuth2Provider(name=provider_name)
    changed = True

desired = {
    "client_type": ClientType.PUBLIC if client_type == "public" else ClientType.CONFIDENTIAL,
    "client_id": client_id,
    "client_secret": client_secret,
    "authorization_flow_id": auth_flow.pk,
    "invalidation_flow_id": invalidation_flow.pk,
    "signing_key_id": signing_key.pk if signing_key else None,
    "grant_types": [GrantType.AUTHORIZATION_CODE, GrantType.REFRESH_TOKEN],
}
for key, value in desired.items():
    if getattr(provider, key) != value:
        setattr(provider, key, value)
        changed = True

old_redirects = list(provider._redirect_uris)
new_redirects = []
for url in redirect_urls:
    new_redirects.append(RedirectURI(RedirectURIMatchingMode.STRICT, url))
provider.redirect_uris = new_redirects
if provider._redirect_uris != old_redirects:
    changed = True

# The M2M mappings need a PK (2026.8): save first, then set them.
provider.save()
current_mapping_pks = set(provider.property_mappings.values_list("pk", flat=True))
wanted_mapping_pks = set()
for mapping in mappings:
    wanted_mapping_pks.add(mapping.pk)
if current_mapping_pks != wanted_mapping_pks:
    provider.property_mappings.set(mappings)
    changed = True

app = Application.objects.filter(slug=slug).first()
if app is None:
    app = Application(slug=slug, name=app_name, provider=provider)
    app.save()
    changed = True
elif app.provider_id != provider.pk:
    app.provider = provider
    app.save()
    changed = True
{% for group in item.groups | default([]) %}

group, created = Group.objects.get_or_create(name={{ group | to_json }})
if created:
    changed = True
{% endfor %}
{% for group in item.admin_groups | default([]) %}

user = User.objects.filter(username="akadmin").first()
group = Group.objects.filter(name={{ group | to_json }}).first()
if user is not None and group is not None and not group.users.filter(pk=user.pk).exists():
    group.users.add(user)
    changed = True
{% endfor %}

print("OIDC_CHANGED" if changed else "OIDC_OK", slug)
