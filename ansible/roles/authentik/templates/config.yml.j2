---
# Managed by Ansible (roles/authentik) - manual edits will be overwritten.
#
# A deliberately PARTIAL override of authentik/lib/default.yml's baked-in
# defaults (docs/01 ADR 59/62) - Authentik's own config loader layers this
# file over its internal defaults, then environment variables over that
# (the header of default.yml itself: "override the settings in this file").
# Unlike community-scripts' authentik-install.sh, which copies the FULL
# default.yml and yq-edits specific keys in place, this only lists what
# actually differs for this deployment - notably postgresql.host and the
# cache/channel redis urls, since this repo reuses the existing shared
# postgresql and garnet LXCs (ADR 59) rather than the script's local-Postgres/
# implicit-localhost-redis assumption.
secret_key: "{{ authentik_secret_key }}"

postgresql:
  host: "{{ hostvars['postgresql'].ansible_host }}"
  name: authentik
  user: authentik
  password: "{{ authentik_db_password }}"
  port: 5432

cache:
  # Port hardcoded (6379, matches garnet_port's own default and the
  # firewall rules elsewhere in this repo) rather than
  # hostvars['garnet'].garnet_port - confirmed live that a role's own
  # defaults/main.yml vars aren't reliably visible via hostvars from a
  # different host's task ("AnsibleUndefinedVariable: ... has no attribute
  # 'garnet_port'"), unlike ansible_host, which inventory always populates.
  url: "redis://{{ hostvars['garnet'].ansible_host }}:6379/{{ authentik_redis_cache_db }}"

channel:
  url: "redis://{{ hostvars['garnet'].ansible_host }}:6379/{{ authentik_redis_channel_db }}"

disable_startup_analytics: true

events:
  context_processors:
    geoip: /opt/authentik-data/geoip/GeoLite2-City.mmdb
    asn: /opt/authentik-data/geoip/GeoLite2-ASN.mmdb

blueprints_dir: /opt/authentik-data/blueprints
cert_discovery_dir: /opt/authentik-data/certs

email:
  template_dir: /opt/authentik-data/templates

storage:
  file:
    path: /opt/authentik-data
