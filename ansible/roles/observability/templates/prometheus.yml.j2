# Managed by Ansible (roles/observability) — manual edits will be overwritten.
global:
  scrape_interval: 15s

# Alert rules live in /etc/prometheus/rules (docs/01 ADR 114).
rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

# App metrics arrive via Alloy's remote_write (config.alloy.j2), not scraped
# here. The scrapes below are infrastructure metrics.
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9091"] # see prometheus.service.j2 - not 9090

  - job_name: alertmanager
    static_configs:
      - targets: ["localhost:9093"]

  # node_exporter on every inventory host (roles/node-exporter), templated from the
  # inventory so a new host is scraped on the next converge. devops is included: the
  # converge installs it locally on the controller (site.yml).
  - job_name: node
    static_configs:
{% for host in groups['all'] | sort %}
      - targets: ["{{ hostvars[host].ansible_host }}:9100"]
        labels:
          host: "{{ host }}"
{% endfor %}

{% if pve_exporter_token_secret is defined %}
  # Proxmox cluster via prometheus-pve-exporter (roles/pve-exporter, ADR 115): Prometheus
  # asks the local exporter to query the Proxmox API at pve_exporter_target.
  - job_name: pve
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["1"]
    static_configs:
      - targets: ["{{ pve_exporter_target }}"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9221
{% endif %}

{% if snmp_exporter_enabled | bool %}
  # Synology NAS and Kemp LoadMaster over SNMPv3 via the local snmp_exporter (roles/snmp-exporter,
  # ADR 116).
  - job_name: snmp_synology
    metrics_path: /snmp
    params:
      module: [synology]
      auth: [homelab_v3]
    static_configs:
      - targets: ["{{ snmp_synology_target }}"]
        labels:
          host: synology-nas
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9116

  - job_name: snmp_kemp
    metrics_path: /snmp
    params:
      module: [kemp]
      auth: [homelab_v3]
    static_configs:
      - targets: ["{{ snmp_kemp_target }}"]
        labels:
          host: kemp
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9116
{% endif %}
