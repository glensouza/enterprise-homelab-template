# Managed by Ansible (roles/observability) — manual edits will be overwritten.
# OTLP receiver here is deliberately NOT 4317/4318 — Alloy owns those ports as
# the app-facing endpoint (docs/07); Tempo only receives from Alloy, locally.
server:
  http_listen_port: 3200

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 127.0.0.1:4327
        http:
          endpoint: 127.0.0.1:4328

storage:
  trace:
    backend: local
    local:
      path: /var/lib/tempo/traces
    wal:
      path: /var/lib/tempo/wal

# No compactor/retention override - confirmed live against the installed
# Tempo 3.0.3: a top-level `compactor:` block no longer exists at all
# ("field compactor not found in type app.Config"). block_retention moved
# under backend-scheduler/backend-worker, Tempo's newer distributed
# deployment components, which this simple single-binary `target=all`
# monolithic mode doesn't use. Tempo's own built-in default (336h) is fine
# for a stub LXC that lives only for the length of one filming session.
