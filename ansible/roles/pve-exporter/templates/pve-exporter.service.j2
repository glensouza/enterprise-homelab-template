# Managed by Ansible (roles/pve-exporter) — docs/01 ADR 115.
[Unit]
Description=Prometheus Proxmox VE exporter
After=network-online.target
Wants=network-online.target

[Service]
User=pve-exporter
Group=pve-exporter
ExecStart=/opt/pve-exporter/bin/pve_exporter --config.file=/etc/pve-exporter/pve.yml --web.listen-address=127.0.0.1:9221
Restart=on-failure

[Install]
WantedBy=multi-user.target
