# Managed by Ansible (roles/postgres) — without this, PostgreSQL only binds
# 127.0.0.1/::1 (Debian package default) and every remote client (the app on
# blazor-web-03/04, the CI runner's EF migration bundle, pgAdmin on the
# preview host) gets "Connection refused", not an auth error. pg_hba.conf
# (below) is still what actually gates who can connect.
listen_addresses = '*'
