---
# Reference only - this key is NOT read from this file (or from any file
# in group_vars/). Copy it into /opt/ansible-secrets/dns.yml on the devops
# LXC instead (ADR 36) - an absolute path outside any git checkout, passed
# to ansible-playbook as -e @/opt/ansible-secrets/dns.yml (the
# ansible-playbook-site.sh wrapper does this for you). NEVER commit the
# real value anywhere in this repo.
#
# Create the token in the Technitium web UI (http://10.10.130.119:5380,
# after changing the default admin/admin login): Administration -> Sessions
# -> Create Token.
technitium_api_token: "<token>"
