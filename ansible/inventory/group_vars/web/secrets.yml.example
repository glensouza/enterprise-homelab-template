---
# Reference only - these keys are NOT read from this file (or from any
# file in group_vars/). Copy them into /opt/ansible-secrets/web.yml on the
# devops LXC instead (ADR 36) - an absolute path outside any git checkout,
# passed to ansible-playbook as -e @/opt/ansible-secrets/web.yml (the
# ansible-playbook-site.sh wrapper does this for you). NEVER commit the
# real values anywhere in this repo.
#
# The Infisical Agent's READ-ONLY machine identity (LAB-RUNBOOK.md step 8.2,
# docs/01 ADR 12/28) - deliberately the *other* identity from
# infisical_provision_client_id/secret in /opt/ansible-secrets/all.yml,
# which can create/edit secrets. This one only needs read access, since
# it's the credential that ends up deployed onto both web LXCs.
infisical_agent_client_id: "<client-id>"
infisical_agent_client_secret: "<client-secret>"
