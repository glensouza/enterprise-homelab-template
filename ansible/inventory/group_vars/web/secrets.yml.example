---
# Copy to secrets.yml (git-ignored) in this same directory and fill in.
# NEVER commit secrets.yml.
#
# The Infisical Agent's READ-ONLY machine identity (LAB-RUNBOOK.md step 8.2,
# docs/01 ADR 12/28) - deliberately the *other* identity from
# infisical_provision_client_id/secret in group_vars/all/secrets.yml, which
# can create/edit secrets. This one only needs read access, since it's the
# credential that ends up deployed onto both web LXCs.
infisical_agent_client_id: "<client-id>"
infisical_agent_client_secret: "<client-secret>"
