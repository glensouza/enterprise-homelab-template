---
# Reference only - these keys are NOT read from this file (or from any
# file in group_vars/). Copy them into /opt/ansible-secrets/all.yml on the
# devops LXC instead (ADR 36) - an absolute path outside any git checkout,
# passed to ansible-playbook as -e @/opt/ansible-secrets/all.yml (the
# ansible-playbook-site.sh wrapper does this for you). NEVER commit the
# real values anywhere in this repo.
#
# These come from Infisical itself, not generated by Ansible, and none of
# them survive a teardown/rebuild of the infisical LXC (a fresh instance
# issues fresh IDs and credentials for all four of these).
#
# infisical_project_id / infisical_environment: from the project URL shown
# in the Infisical UI, e.g.
#   .../projects/secret-management/<PROJECT_ID>/overview?environments=["dev"]
#
# infisical_provision_client_id / infisical_provision_client_secret:
# Infisical UI -> Access Control -> Machine Identities -> Create -> add to
# the project with a role that can CREATE/EDIT secrets (not the read-only
# role the Agent identity uses on the web LXCs, LAB-RUNBOOK step 8.2 - keep
# provisioning writes and app-server reads on two separate identities).
infisical_project_id: "<project-id>"
infisical_environment: "dev"
infisical_provision_client_id: "<client-id>"
infisical_provision_client_secret: "<client-secret>"

# patchmon_enrollment_token_key / _secret (ADR 34): PatchMon UI -> Settings
# -> Auto Enrollment -> Create Token, after completing the first-run admin
# signup at http://10.10.130.122:3000. Same "doesn't survive a rebuild"
# caveat as the Infisical values above - a fresh PatchMon instance issues a
# fresh token.
patchmon_enrollment_token_key: "<token-key>"
patchmon_enrollment_token_secret: "<token-secret>"

# uptime_kuma_username / _password (ADR 60): whatever admin account you
# created by hand through Kuma's own first-run "Turn on login"-equivalent
# setup wizard at http://10.10.130.117:3001. Ansible never generates or
# sees this typed into a field - it's the operator's own personal
# credential, supplied here only so the monitor-seeding script can log in
# the same way a human would. Same "doesn't survive a rebuild" caveat as
# the values above.
uptime_kuma_username: "<your-kuma-username>"
uptime_kuma_password: "<your-kuma-password>"

# lxc_root_password (ADR 87): a fleet-wide root password, applied to every
# Terraform-managed LXC except devops (which keeps its own distinct,
# manually-set password, ADR 82 - never overwritten by this). Your own
# choice, not generated or seen by Ansible beyond hashing it in memory
# (roles/root-password, no_log throughout). Push a copy into Infisical for
# safekeeping the same way devops's own password was (LAB-RUNBOOK.md DevOps
# LXC section):
#   ansible-playbook store-secret.yml -e @/opt/ansible-secrets/all.yml -e infisical_secret_name=LXC_FLEET_ROOT_PASSWORD
lxc_root_password: "<your-fleet-wide-root-password>"
