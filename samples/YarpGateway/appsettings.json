{
  "Urls": "http://localhost:5080",
  "ReverseProxy": {
    "Routes": {
      "auctions": {
        "ClusterId": "brewhouse",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "brewhouse": {
        "Destinations": {
          "web01": { "Address": "http://localhost:5000/" },
          "web02": { "Address": "http://localhost:5001/" }
        }
      }
    }
  }
}
